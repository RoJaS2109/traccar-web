<Point>
          <coordinates>
            -68.89442,-22.43902,0
          </coordinates>
        </Point>
      </Placemark>
      <Placemark>
        <name>-39.65896, -72.32804</name>
        <description><![CDATA[28 de septiembre de 2024 por thardtmann <br>Taller general con excelente atención.]]></description>
        <styleUrl>#icon-1590-0288D1</styleUrl>
        <Point>
