      </Placemark>
      <Placemark>
        <name>Mecanica Integral Gottau e Hijo</name>
        <description><![CDATA[<br><br>Excelente atención, puntual, y sobre todo buena onda! ❤️<br><br>Buena atención y rapidez. Te tratan de diez puntos<br><br>Satisfecho.                02914489285]]></description>
        <styleUrl>#icon-1590-0288D1</styleUrl>
<Point>
          <coordinates>
            -62.2872874,-38.7231172,0
          </coordinates>
        </Point>
      </Placemark>
      <Placemark>
        <name>Christian Moreno</name>
